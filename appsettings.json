{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs\\vrdatasyncservice-.log",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}",
          "rollingInterval": "Infinite",
          "shared": true,
          "flushToDiskInterval": "00:00:01"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Sync": {
    "SyncName": "VFC_AMR_RP_to_VF_AMR_RP1",
    "BatchSize": 10000,
    "BatchSizeOverrides": {
      "Section2": null,
      "SectionMeta2": null,
      "SectionCentera2": null,
      "SectionCdrMedia2": null
    },
    "TestMode": {
      "Enabled": false,
      "MaxRows": {
        "Section2": 50000,
        "SectionMeta2": 50000,
        "SectionCentera2": 50000,
        "SectionCdrMedia2": 50000
      }
    },
    "SourceTotalRows": {
      "Section2": null,
      "SectionMeta2": null,
      "SectionCentera2": null,
      "SectionCdrMedia2": null
    },
    "Performance": {
      "EnableAdaptiveBatchSizing": true,
      "MinBatchSize": 1000,
      "MaxBatchSize": 25000,
      "SlowBatchThresholdSeconds": 45,
      "FastBatchThresholdSeconds": 8
    },
    "Resilience": {
      "CommandTimeoutSeconds": 600,
      "BulkCopyTimeoutSeconds": 0,
      "MaxRetryAttempts": 5,
      "RetryBaseDelaySeconds": 2,
      "RetryMaxDelaySeconds": 30
    },
    "SourceConnectionString": "Server=ISAMU-SQL.DOZER.AVA,1433;Database=VFC_AMR_RP;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;",
    "DestinationConnectionString": "Server=NEO\\NEOSQL;Database=VF_AMR_RP1;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;"
  }
}
