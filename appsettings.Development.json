{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Sync": {
    "SyncName": "Source_to_Destination",
    "BatchSize": 10000,
    "SourceConnectionString": "Server=<SOURCE_SERVER>;Database=<SOURCE_DATABASE>;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;",
    "DestinationConnectionString": "Server=<DESTINATION_SERVER>;Database=<DESTINATION_DATABASE>;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;"
  }
}
